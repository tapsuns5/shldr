# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_TELEMETRY_DISABLED=1

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/shldr"

# ─── BetterAuth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Used for both sign-in and the Gmail integration (gmail.readonly scope).
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Gmail Push Notifications ───────────────────────────────────────────────
# Google Cloud Pub/Sub topic for Gmail push notifications.
# Format: projects/PROJECT_ID/topics/TOPIC_NAME
GMAIL_PUBSUB_TOPIC="projects/your-project/topics/gmail-notifications"
# AES-256 key for encrypting stored Gmail OAuth tokens (base64, 32 bytes).
# Generate with: openssl rand -base64 32
GMAIL_ENCRYPTION_KEY="your-base64-32-byte-key"

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
# Redis URL for the background job queue (BullMQ).
REDIS_URL="redis://localhost:6379"

# ─── Microsoft OAuth ─────────────────────────────────────────────────────────
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# https://dash.cloudflare.com/ → R2 → Manage API tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="tripit-documents"
# Public URL for your R2 bucket (configure custom domain or use r2.dev subdomain)
R2_PUBLIC_URL="https://your-bucket.your-account.r2.cloudflarestorage.com"

# ─── Google Maps ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Enable Maps JavaScript API & Places API
# The same key is also used for Google Places Photos (city/landmark images).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ─── Pexels (coastal/resort images) ──────────────────────────────────────────
# Sign up at https://www.pexels.com/api/ → Get your API key
# Free tier: 200 requests/hour, 20,000 requests/month
PEXELS_API_KEY="your-pexels-api-key"

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Shared secret for POST /api/webhooks/email-import
# Generate with: openssl rand -hex 32
# Send as header:  x-webhook-secret: <value>
# or query param:  ?secret=<value>
WEBHOOK_SECRET="your-webhook-secret-here"

# ─── Email (optional) ────────────────────────────────────────────────────────
# Install nodemailer (npm i nodemailer) to enable email invite sending.
# Without these, invites still work via link — emails are just skipped.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@example.com"
