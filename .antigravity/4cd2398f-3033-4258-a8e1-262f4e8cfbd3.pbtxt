      name: "create_file"
      arguments_json: "{\"Content\":\"\'use client\';\\n\\nimport React, { useState } from \'react\';\\nimport {\\n  AppBar,\\n  Toolbar,\\n  Typography,\\n  Container,\\n  Box,\\n  Tabs,\\n  Tab,\\n  Button,\\n  Card,\\n  CardContent,\\n  IconButton,\\n  Avatar,\\n  Divider,\\n  List,\\n  ListItem,\\n  ListItemIcon,\\n  ListItemText,\\n  ThemeProvider,\\n  createTheme,\\n  CssBaseline,\\n  ButtonGroup,\\n} from \'@mui/material\';\\nimport {\\n  Add as AddIcon,\\n  Edit as EditIcon,\\n  MoreHoriz as MoreHorizIcon,\\n  FlightTakeoff as FlightIcon,\\n  DirectionsCar as CarIcon,\\n  Hotel as HotelIcon,\\n  ArrowBack as ArrowBackIcon,\\n  Language as LanguageIcon,\\n  ChatBubbleOutline as ChatIcon,\\n  AccountCircle as AccountIcon,\\n  Link as LinkIcon,\\n} from \'@mui/icons-material\';\\nimport { motion, AnimatePresence } from \'motion/react\';\\n\\n// Custom Theme to match TripIt branding\\nconst theme = createTheme({\\n  palette: {\\n    primary: {\\n      main: \'#005596\', // TripIt Blue\\n    },\\n    secondary: {\\n      main: \'#F37021\', // TripIt Orange\\n    },\\n    background: {\\n      default: \'#f8f9fa\',\\n    },\\n  },\\n  typography: {\\n    fontFamily: \'\\\"Helvetica Neue\\\", Helvetica, Arial, sans-serif\',\\n    h5: {\\n      fontWeight: 600,\\n      color: \'#005596\',\\n    },\\n    h6: {\\n      fontWeight: 600,\\n    },\\n  },\\n  components: {\\n    MuiButton: {\\n      styleOverrides: {\\n        root: {\\n          textTransform: \'none\',\\n          borderRadius: 8,\\n        },\\n      },\\n    },\\n    MuiTab: {\\n      styleOverrides: {\\n        root: {\\n          textTransform: \'none\',\\n          fontWeight: 600,\\n          minWidth: 0,\\n          marginRight: 24,\\n        },\\n      },\\n    },\\n  },\\n});\\n\\n// Mock Data\\nconst MOCK_TRIPS = [\\n  {\\n    id: \'1\',\\n    title: \'Split, Croatia\',\\n    date: \'Sep 26 - Oct 10, 2025\',\\n    duration: \'15 days\',\\n    location: \'Split, Croatia\',\\n    image: \'https://picsum.photos/seed/split/400/300\',\\n    plans: [\\n      {\\n        id: \'p1\',\\n        date: \'Fri, Sep 26 2025\',\\n        items: [\\n          {\\n            id: \'i1\',\\n            time: \'7:00 AM\',\\n            timezone: \'EDT\',\\n            type: \'flight\',\\n            title: \'FLL - EWR\',\\n            details: \'Flight Number B6 306\\\\nTerminal 3, Gate E2\\\\nArrive 9/26/2025 9:59 AM EDT\',\\n          },\\n          {\\n            id: \'i2\',\\n            time: \'11:00 AM\',\\n            timezone: \'EDT\',\\n            type: \'car\',\\n            title: \'National Car Rental\',\\n            details: \'Pick up 11:00 AM EDT\\\\n132 CARSON RD NEWARK NJ 07114 US\',\\n          },\\n        ],\\n      },\\n      {\\n        id: \'p2\',\\n        date: \'Sun, Sep 28 2025\',\\n        items: [\\n          {\\n            id: \'i3\',\\n            time: \'5:30 PM\',\\n            timezone: \'EDT\',\\n            type: \'flight\',\\n            title: \'JFK - AMS\',\\n            details: \'Flight Number KL 642\\\\nConfirmation: JK8SHS\',\\n          },\\n        ],\\n      },\\n    ],\\n  },\\n  {\\n    id: \'2\',\\n    title: \'Austin, TX\',\\n    date: \'Oct 20, 2025\',\\n    duration: \'1 day\',\\n    location: \'Austin, TX\',\\n    image: \'https://picsum.photos/seed/austin/400/300\',\\n  },\\n  {\\n    id: \'3\',\\n    title: \'Fort Lauderdale, FL\',\\n    date: \'Dec 4, 2025\',\\n    duration: \'1 day\',\\n    location: \'Fort Lauderdale, FL\',\\n    image: \'https://picsum.photos/seed/fll/400/300\',\\n  },\\n];\\n\\nexport default function TripItClone() {\\n  const [view, setView] = useState<\'list\' | \'detail\'>(\'list\');\\n  const [selectedTrip, setSelectedTrip] = useState<typeof MOCK_TRIPS[0] | null>(null);\\n  const [tabValue, setTabValue] = useState(0);\\n\\n  const handleTripClick = (trip: typeof MOCK_TRIPS[0]) => {\\n    setSelectedTrip(trip);\\n    setView(\'detail\');\\n  };\\n\\n  const handleBack = () => {\\n    setView(\'list\');\\n    setSelectedTrip(null);\\n  };\\n\\n  return (\\n    <ThemeProvider theme={theme}>\\n      <CssBaseline />\\n      <Box sx={{ flexGrow: 1, minHeight: \'100vh\', bgcolor: \'background.default\' }}>\\n        {/* Header */}\\n        <AppBar position=\\\"static\\\" color=\\\"inherit\\\" elevation={0} sx={{ borderBottom: \'1px solid #e0e0e0\' }}>\\n          <Container maxWidth=\\\"lg\\\">\\n            <Toolbar disableGutters sx={{ justifyContent: \'space-between\' }}>\\n              <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 1 }}>\\n                <Typography\\n                  variant=\\\"h4\\\"\\n                  component=\\\"div\\\"\\n                  sx={{\\n                    fontWeight: 900,\\n                    color: \'#005596\',\\n                    fontStyle: \'italic\',\\n                    letterSpacing: -1,\\n                  }}\\n                >\\n                  Trip<span style={{ color: \'#F37021\' }}>it</span>\\n                </Typography>\\n              </Box>\\n\\n              <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 3 }}>\\n                <Typography variant=\\\"body2\\\" sx={{ fontWeight: 600, cursor: \'pointer\', borderBottom: \'3px solid #005596\', pb: 2, mt: 2 }}>\\n                  Trips\\n                </Typography>\\n                <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, cursor: \'pointer\' }}>\\n                  <Typography variant=\\\"body2\\\" sx={{ fontWeight: 600 }}>Support</Typography>\\n                  <MoreHorizIcon fontSize=\\\"small\\\" sx={{ transform: \'rotate(90deg)\' }} />\\n                </Box>\\n                <IconButton size=\\\"small\\\"><ChatIcon fontSize=\\\"small\\\" /></IconButton>\\n                <Button\\n                  variant=\\\"outlined\\\"\\n                  size=\\\"small\\\"\\n                  startIcon={<AccountIcon />}\\n                  endIcon={<MoreHorizIcon fontSize=\\\"small\\\" sx={{ transform: \'rotate(90deg)\' }} />}\\n                  sx={{ borderColor: \'#e0e0e0\', color: \'text.primary\' }}\\n                >\\n                  <Box component=\\\"span\\\" sx={{ bgcolor: \'#005596\', color: \'white\', px: 1, borderRadius: 1, fontSize: \'0.7rem\', fontWeight: 800, mr: 1 }}>PRO</Box>\\n                </Button>\\n                <Button\\n                  variant=\\\"outlined\\\"\\n                  size=\\\"small\\\"\\n                  startIcon={<LanguageIcon />}\\n                  endIcon={<MoreHorizIcon fontSize=\\\"small\\\" sx={{ transform: \'rotate(90deg)\' }} />}\\n                  sx={{ borderColor: \'#e0e0e0\', color: \'text.primary\' }}\\n                >\\n                  EN\\n                </Button>\\n              </Box>\\n            </Toolbar>\\n          </Container>\\n        </AppBar>\\n\\n        <Container maxWidth=\\\"lg\\\" sx={{ py: 4 }}>\\n          <AnimatePresence mode=\\\"wait\\\">\\n            {view === \'list\' ? (\\n              <motion.div\\n                key=\\\"list\\\"\\n                initial={{ opacity: 0, y: 20 }}\\n                animate={{ opacity: 1, y: 0 }}\\n                exit={{ opacity: 0, y: -20 }}\\n              >\\n                {/* Tabs */}\\n                <Box sx={{ borderBottom: 1, borderColor: \'divider\', mb: 3 }}>\\n                  <Tabs value={tabValue} onChange={(_, v) => setTabValue(v)} aria-label=\\\"trip tabs\\\">\\n                    <Tab label=\\\"Your Upcoming Trips\\\" />\\n                    <Tab label=\\\"Others\' Upcoming Trips\\\" />\\n                    <Tab label=\\\"Past Trips\\\" />\\n                    <Tab label=\\\"Unfiled Items\\\" />\\n                  </Tabs>\\n                </Box>\\n\\n                {/* Actions Bar */}\\n                <Box sx={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', mb: 4 }}>\\n                  <Button\\n                    startIcon={<AddIcon sx={{ bgcolor: \'primary.main\', color: \'white\', borderRadius: \'50%\', p: 0.2 }} />}\\n                    sx={{ color: \'primary.main\', fontWeight: 600 }}\\n                  >\\n                    Add a Trip\\n                  </Button>\\n                  <ButtonGroup size=\\\"small\\\" sx={{ bgcolor: \'white\' }}>\\n                    <Button variant=\\\"contained\\\">All</Button>\\n                    <Button variant=\\\"outlined\\\" sx={{ color: \'text.secondary\', borderColor: \'#e0e0e0\' }}>Your Trips</Button>\\n                    <Button variant=\\\"outlined\\\" sx={{ color: \'text.secondary\', borderColor: \'#e0e0e0\' }}>Others\' Trips</Button>\\n                  </ButtonGroup>\\n                </Box>\\n\\n                {/* Trip Cards */}\\n                <Box sx={{ display: \'flex\', flexDirection: \'column\', gap: 3 }}>\\n                  {MOCK_TRIPS.map((trip) => (\\n                    <Card\\n                      key={trip.id}\\n                      elevation={0}\\n                      sx={{\\n                        border: \'1px solid #e0e0e0\',\\n                        borderRadius: 2,\\n                        overflow: \'hidden\',\\n                        cursor: \'pointer\',\\n                        transition: \'transform 0.2s\',\\n                        \'&:hover\': { transform: \'translateY(-2px)\', boxShadow: \'0 4px 12px rgba(0,0,0,0.05)\' },\\n                      }}\\n                      onClick={() => handleTripClick(trip)}\\n                    >\\n                      <Box sx={{ display: \'flex\' }}>\\n                        <CardContent sx={{ flex: 1, p: 3 }}>\\n                          <Typography variant=\\\"h5\\\" gutterBottom>\\n                            {trip.title}, February 2026\\n                          </Typography>\\n                          <Typography variant=\\\"body2\\\" color=\\\"text.secondary\\\" sx={{ mb: 2 }}>\\n                            {trip.date} ({trip.duration})\\n                          </Typography>\\n                          \\n                          <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 2, mb: 3 }}>\\n                            <Avatar sx={{ width: 24, height: 24, bgcolor: \'secondary.main\', fontSize: \'0.7rem\' }}>C</Avatar>\\n                            <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\' }}>\\n                              <LinkIcon fontSize=\\\"small\\\" />\\n                              <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>Manage Sharing</Typography>\\n                            </Box>\\n                          </Box>\\n\\n                          <Box sx={{ display: \'flex\', gap: 3 }}>\\n                            <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\' }}>\\n                              <EditIcon fontSize=\\\"small\\\" />\\n                              <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>Edit Trip Info</Typography>\\n                            </Box>\\n                            <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\' }}>\\n                              <MoreHorizIcon fontSize=\\\"small\\\" />\\n                              <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>More Options</Typography>\\n                            </Box>\\n                          </Box>\\n                        </CardContent>\\n                        <Box\\n                          sx={{\\n                            width: 300,\\n                            backgroundImage: `url(${trip.image})`,\\n                            backgroundSize: \'cover\',\\n                            backgroundPosition: \'center\',\\n                            position: \'relative\',\\n                          }}\\n                        >\\n                           <Box sx={{ position: \'absolute\', bottom: 16, left: 16, bgcolor: \'primary.main\', p: 1, borderRadius: 1, display: \'flex\' }}>\\n                              <Box sx={{ width: 20, height: 20, bgcolor: \'white\', borderRadius: \'4px 4px 0 0\', position: \'relative\' }}>\\n                                <Box sx={{ position: \'absolute\', top: -4, left: 4, width: 12, height: 6, border: \'2px solid white\', borderRadius: \'4px 4px 0 0\' }} />\\n                              </Box>\\n                           </Box>\\n                        </Box>\\n                      </Box>\\n                    </Card>\\n                  ))}\\n                </Box>\\n              </motion.div>\\n            ) : (\\n              <motion.div\\n                key=\\\"detail\\\"\\n                initial={{ opacity: 0, x: 20 }}\\n                animate={{ opacity: 1, x: 0 }}\\n                exit={{ opacity: 0, x: -20 }}\\n              >\\n                {/* Back Button */}\\n                <Button\\n                  startIcon={<ArrowBackIcon />}\\n                  onClick={handleBack}\\n                  sx={{ mb: 3, color: \'primary.main\', fontWeight: 600 }}\\n                >\\n                  Back to Trips\\n                </Button>\\n\\n                {/* Trip Detail Header */}\\n                <Box sx={{ display: \'flex\', justifyContent: \'space-between\', mb: 4 }}>\\n                  <Box>\\n                    <Typography variant=\\\"h4\\\" sx={{ fontWeight: 700, color: \'text.primary\', mb: 1 }}>\\n                      {selectedTrip?.title}, September 2025\\n                    </Typography>\\n                    <Typography variant=\\\"body1\\\" color=\\\"text.secondary\\\" sx={{ mb: 1 }}>\\n                      {selectedTrip?.location}\\n                    </Typography>\\n                    <Typography variant=\\\"body2\\\" color=\\\"text.secondary\\\" sx={{ mb: 2 }}>\\n                      {selectedTrip?.date} ({selectedTrip?.duration})\\n                    </Typography>\\n\\n                    <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 1, mb: 3 }}>\\n                      <Avatar sx={{ width: 24, height: 24, bgcolor: \'secondary.main\', fontSize: \'0.7rem\' }}>C</Avatar>\\n                      <Avatar sx={{ width: 24, height: 24, bgcolor: \'primary.main\', fontSize: \'0.7rem\' }}><LinkIcon sx={{ fontSize: 14 }} /></Avatar>\\n                      <Avatar sx={{ width: 24, height: 24, bgcolor: \'black\', fontSize: \'0.7rem\', fontWeight: 800 }}>EP</Avatar>\\n                      <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\', ml: 1 }}>\\n                        <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>Manage Sharing</Typography>\\n                      </Box>\\n                    </Box>\\n\\n                    <Box sx={{ display: \'flex\', gap: 3 }}>\\n                      <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\' }}>\\n                        <EditIcon fontSize=\\\"small\\\" />\\n                        <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>Edit Trip Info</Typography>\\n                      </Box>\\n                      <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\' }}>\\n                        <MoreHorizIcon fontSize=\\\"small\\\" />\\n                        <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>More Options</Typography>\\n                        <MoreHorizIcon fontSize=\\\"small\\\" sx={{ transform: \'rotate(90deg)\', ml: -0.5 }} />\\n                      </Box>\\n                    </Box>\\n                  </Box>\\n\\n                  <Box\\n                    sx={{\\n                      width: 240,\\n                      height: 180,\\n                      borderRadius: 2,\\n                      backgroundImage: `url(${selectedTrip?.image})`,\\n                      backgroundSize: \'cover\',\\n                      backgroundPosition: \'center\',\\n                      position: \'relative\',\\n                    }}\\n                  >\\n                     <Box sx={{ position: \'absolute\', bottom: 16, left: 16, bgcolor: \'primary.main\', p: 1, borderRadius: 1 }}>\\n                        <Box sx={{ width: 20, height: 20, bgcolor: \'white\', borderRadius: \'4px 4px 0 0\', position: \'relative\' }}>\\n                          <Box sx={{ position: \'absolute\', top: -4, left: 4, width: 12, height: 6, border: \'2px solid white\', borderRadius: \'4px 4px 0 0\' }} />\\n                        </Box>\\n                     </Box>\\n                  </Box>\\n                </Box>\\n\\n                {/* Itinerary Timeline */}\\n                <Box sx={{ position: \'relative\' }}>\\n                  {/* Add Plan Button (Floating) */}\\n                  <Box sx={{ display: \'flex\', justifyContent: \'center\', mb: -3, position: \'relative\', zIndex: 2 }}>\\n                    <Button\\n                      variant=\\\"contained\\\"\\n                      startIcon={<AddIcon sx={{ bgcolor: \'white\', color: \'primary.main\', borderRadius: \'50%\', p: 0.1 }} />}\\n                      sx={{\\n                        borderRadius: 10,\\n                        px: 3,\\n                        py: 1.5,\\n                        boxShadow: \'0 4px 12px rgba(0,0,0,0.1)\',\\n                        bgcolor: \'white\',\\n                        color: \'primary.main\',\\n                        border: \'1px solid #e0e0e0\',\\n                        \'&:hover\': { bgcolor: \'#f5f5f5\' }\\n                      }}\\n                    >\\n                      Add a Plan\\n                    </Button>\\n                  </Box>\\n\\n                  {selectedTrip?.plans?.map((day, dayIdx) => (\\n                    <Box key={day.id} sx={{ mb: 4 }}>\\n                      <Box sx={{ bgcolor: \'#f0f2f5\', py: 1, px: 2, borderRadius: 1, mb: 2 }}>\\n                        <Typography variant=\\\"subtitle2\\\" sx={{ fontWeight: 700, color: \'text.secondary\' }}>\\n                          {day.date}\\n                        </Typography>\\n                      </Box>\\n\\n                      <List disablePadding>\\n                        {day.items.map((item, itemIdx) => (\\n                          <ListItem key={item.id} sx={{ alignItems: \'flex-start\', pb: 4, position: \'relative\' }}>\\n                            {/* Timeline Line */}\\n                            <Box\\n                              sx={{\\n                                position: \'absolute\',\\n                                left: 148,\\n                                top: 40,\\n                                bottom: 0,\\n                                width: 2,\\n                                bgcolor: \'#bdbdbd\',\\n                                display: dayIdx === selectedTrip.plans!.length - 1 && itemIdx === day.items.length - 1 ? \'none\' : \'block\',\\n                              }}\\n                            />\\n\\n                            <Box sx={{ width: 120, textAlign: \'right\', pr: 3, pt: 1 }}>\\n                              <Typography variant=\\\"subtitle1\\\" sx={{ fontWeight: 700 }}>\\n                                {item.time}\\n                              </Typography>\\n                              <Typography variant=\\\"caption\\\" color=\\\"text.secondary\\\">\\n                                {item.timezone}\\n                              </Typography>\\n                            </Box>\\n\\n                            <ListItemIcon sx={{ minWidth: 60, pt: 0.5 }}>\\n                              <Avatar sx={{ bgcolor: \'#9e9e9e\', width: 40, height: 40 }}>\\n                                {item.type === \'flight\' ? <FlightIcon /> : <CarIcon />}\\n                              </Avatar>\\n                            </ListItemIcon>\\n\\n                            <ListItemText\\n                              primary={\\n                                <Box sx={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'flex-start\' }}>\\n                                  <Typography variant=\\\"h6\\\" color=\\\"primary.main\\\">\\n                                    {item.title}\\n                                  </Typography>\\n                                  <Box sx={{ display: \'flex\', alignItems: \'center\', gap: 0.5, color: \'primary.main\', cursor: \'pointer\' }}>\\n                                    <MoreHorizIcon fontSize=\\\"small\\\" />\\n                                    <Typography variant=\\\"caption\\\" sx={{ fontWeight: 600 }}>Actions</Typography>\\n                                  </Box>\\n                                </Box>\\n                              }\\n                              secondary={\\n                                <Typography variant=\\\"body2\\\" color=\\\"text.secondary\\\" sx={{ whiteSpace: \'pre-line\', mt: 1 }}>\\n                                  {item.details}\\n                                </Typography>\\n                              }\\n                            />\\n                          </ListItem>\\n                        ))}\\n                      </List>\\n                    </Box>\\n                  ))}\\n                </Box>\\n              </motion.div>\\n            )}\\n          </AnimatePresence>\\n        </Container>\\n      </Box>\\n    </ThemeProvider>\\n  );\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/app/page.tsx\"}"
